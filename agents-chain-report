#!/usr/bin/env node
async function main() {
  const { parseArgs } = await import('node:util')
  const { join } = await import('node:path')
  const { defaultRoot } = await import('./lib/agents-chain.mjs')
  const { formatReport, readReport } = await import('./lib/agents-chain-report.mjs')

  const HELP = `Usage: agents-chain-report [options]

  Read-only summary of agents-chain log.jsonl.1 and log.jsonl, grouped by
  runtime and mode. Requires Node.js 22 or newer; no additional packages.

  Options:
    -h, --help          Show help
    -s, --since TIME    Include records at or after an ISO-8601 timestamp
                        Example: 2026-10-23T00:00:00Z (offsets accepted)
    -f, --file PATH     Read only this JSONL file instead of retained logs
    -u, --usage-file PATH
                        Also summarize this local runtime transcript (repeatable)
        --json          Print structured JSON instead of a readable report
        --              End options (there are no positional arguments)

  Default logs: XDG_STATE_HOME/agents-chain/ (fallback: $HOME/.local/state/agents-chain/)
  Records require ts, runtime and decision; session, mode and additive hook
  fields are optional. Malformed records are counted and skipped. Missing
  measurements remain unknown. Epoch totals cover observed records only;
  rotation and --since can leave partial epochs. Resume and failed resets
  preserve an epoch; unknown sources mark uncertain boundaries.
  Parse-miss rate: measured shell calls with unresolved words / measured
  shell calls. Outlines are counted as delivered bytes despite cap exemption.
  Token estimates use UTF-8 bytes / 4, not model tokenizer or billing counts.
  Usage files accept Codex session_meta and token_count snapshots or Claude
  assistant-message usage records with request/message and session IDs.
  Explicit usage sources are best-effort: missing/unsupported sources and
  malformed records are reported without failing the main hook report.
  --since subtracts a preceding Codex snapshot; without a needed baseline
  usage remains unknown. Claude requests are filtered by first observation.
  Sources are limited to regular files of at most 64 MiB; lines over 1 MiB
  are skipped. Sensitive credential paths are rejected. No files are written.

  Exit statuses: 0 success/help (including no default logs), 1 read failure,
  2 invalid options or timestamp. Results go to stdout; errors to stderr.
  `

  function timestamp(value) {
    if (!/^\d{4}-\d{2}-\d{2}T(?:[01]\d|2[0-3]):[0-5]\d:[0-5]\d(?:\.\d{1,3})?(?:Z|[+-]\d{2}:\d{2})$/.test(value)) return null
    const parsed = new Date(value)
    const date = new Date(`${value.slice(0, 10)}T00:00:00Z`)
    if (!Number.isFinite(parsed.getTime()) || !Number.isFinite(date.getTime()) || date.toISOString().slice(0, 10) !== value.slice(0, 10)) return null
    return parsed.toISOString()
  }

  let values
  try {
    ({ values } = parseArgs({ options: { help: { type: 'boolean', short: 'h' }, since: { type: 'string', short: 's' }, file: { type: 'string', short: 'f' }, 'usage-file': { type: 'string', short: 'u', multiple: true }, json: { type: 'boolean' } }, allowPositionals: false }))
    if (values.since !== undefined && !timestamp(values.since)) throw new Error('--since requires a complete ISO-8601 timestamp')
    if (values.file !== undefined && !values.file) throw new Error('--file requires a non-empty path')
    if (values['usage-file']?.some(path => !path)) throw new Error('--usage-file requires a non-empty path')
  } catch (error) {
    process.stderr.write(`agents-chain-report: ${error.message}\n`)
    process.exitCode = 2
  }
  if (values && !process.exitCode) {
    if (values.help) process.stdout.write(HELP)
    else {
      try {
        const root = defaultRoot()
        const files = values.file ? [values.file] : [join(root, 'log.jsonl.1'), join(root, 'log.jsonl')]
        const report = await readReport(files, { since: values.since ? timestamp(values.since) : null, allowMissing: !values.file })
        let usageText = ''
        if (values['usage-file']?.length) {
          const { readRuntimeUsage, formatRuntimeUsage } = await import('./lib/agents-chain-usage.mjs')
          report.runtimeUsage = await readRuntimeUsage(values['usage-file'], { since: values.since ? timestamp(values.since) : null })
          usageText = formatRuntimeUsage(report.runtimeUsage)
        }
        process.stdout.write(values.json ? `${JSON.stringify(report, null, 2)}\n` : formatReport(report) + usageText)
      } catch (error) {
        process.stderr.write(`agents-chain-report: Unable to read logs (${error.code ?? 'READ_ERROR'})\n`)
        process.exitCode = 1
      }
    }
  }
}

main().catch(() => {
  process.stderr.write('agents-chain-report: Unable to start command\n')
  process.exitCode = 1
})
